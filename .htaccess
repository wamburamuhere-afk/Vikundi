<IfModule mod_passenger.c>
    PassengerEnabled off
</IfModule>
RewriteEngine On
RewriteBase /

# Disable directory listing & content negotiation
Options -Indexes -MultiViews

# Block direct access to internal files
RewriteRule ^roots\.php$ - [F,L]

# 1. Force Redirect .php to clean URL (page files only — NOT api/ajax/actions)
# Use REQUEST_URI so the check works in subdirectory installs (e.g. /vikundi/api/...
# still contains "/api/" even though %1 would start with "vikundi/").
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^?]+)\.php [NC]
RewriteCond %{REQUEST_URI} !/(actions|ajax|api)/ [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Serve api/ajax/actions PHP files directly so POST body (file uploads, form data)
# is never lost to a redirect.  Without this, multipart uploads to api/ would be
# silently converted to GET requests by the 301 above.
RewriteCond %{REQUEST_URI} /(actions|ajax|api)/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Allow existing non-PHP directories and static files
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !\.php$
RewriteRule ^ - [L]

# 4. Front Controller (all other requests through index.php)
RewriteRule ^ index.php [L,QSA]

# ── Security headers (audit XSS-006) ──────────────────────────────────────────
# Before this, the application sent none at all.
<IfModule mod_headers.c>
    # Never let a browser second-guess a declared Content-Type. Blunts attacks that
    # rely on a file being sniffed as script.
    Header always set X-Content-Type-Options "nosniff"

    # The approval and payment screens were framable, so clickjacking a leader into
    # approving an expense was possible.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Do not leak the full path (which carries member and record ids in the query
    # string) to third-party hosts.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ── CSP: REPORT-ONLY, deliberately not enforced ──────────────────────────
    # This policy is what we believe would be safe to enforce, published so the
    # browser reports what would break rather than breaking it.
    #
    # It CANNOT be enforced today. The tree contains 151 inline <script> blocks,
    # 688 inline event handlers, 55 javascript: hrefs and 896 inline style
    # attributes, so 'unsafe-inline' is load-bearing for both script-src and
    # style-src. Removing it is a migration, not a header change — see the
    # estimate in sessions.md.
    #
    # The external origins below are the four CDNs the app actually loads from:
    # code.jquery.com, cdn.datatables.net, cdn.jsdelivr.net, cdnjs.cloudflare.com.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.datatables.net https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.datatables.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# PHP session cookie path
<IfModule mod_php.c>
    php_value session.cookie_path "/"
</IfModule>

# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
