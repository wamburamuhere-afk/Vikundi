/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
/backups/*
!/backups/.gitkeep
!/backups/.htaccess
/downloads/*
!/downloads/.gitkeep
/documents/*
!/documents/.gitkeep
!/documents/.htaccess

# === Test output ===
/.phpunit.result.cache
/coverage/
/phpunit.xml.local

# === Logs ===
*.log
/logs/

# === FTP deploy state (created by SamKirkland/FTP-Deploy-Action on server) ===
.ftp-deploy-sync-state.json

# === Scratch / temporary dev files ===
/scratch/

